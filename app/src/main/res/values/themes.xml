<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MyHealth" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/teal_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/sky_blue</item>
        <item name="android:statusBarColor">@color/teal_dark</item>
        <item name="android:navigationBarColor">@color/page_bg</item>
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Widget.MyHealth.TealButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/teal_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="Widget.MyHealth.OutlineButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/teal_primary</item>
        <item name="android:textColor">@color/teal_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:padding">14dp</item>
    </style>
</resources>
